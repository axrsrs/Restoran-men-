// neardiji.com — Cloudflare Workers statik site (GitHub'a push → otomatik yayın)
{
  "name": "neardiji",
  "compatibility_date": "2025-01-01",
  // Worker yalnız tek parçalı adreslerde çalışır (neardiji.com/xfirma → menü, 200 + SEO başlıkları).
  // Klasörler ve dosyalar Worker'a hiç uğramadan doğrudan statik sunulur.
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/*",
      "!/",
      "!/*.*",
      "!/assets/*",
      "!/menu/*",
      "!/katalog/*",
      "!/pronto/*",
      "!/821/*",
      "!/ayse/*"
    ]
  }
}
